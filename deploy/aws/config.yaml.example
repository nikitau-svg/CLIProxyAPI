host: ""
port: 8317

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  # Docker bridge traffic is not localhost inside the container. Host exposure
  # is still restricted to 127.0.0.1 by docker-compose.yml.
  allow-remote: true
  # prepare-runtime.sh replaces this value. CLIProxyAPI hashes it on startup.
  secret-key: "__MANAGEMENT_KEY__"
  disable-control-panel: false
  # The image contains the matching Bravo UI. Never replace it with upstream UI.
  disable-auto-update-panel: true

auth-dir: "/root/.cli-proxy-api"

# Ordinary break-glass key for native CLIProxyAPI routes. It cannot access
# bravo/*; project Bravo keys are created later in the Management UI.
api-keys:
  - "__ORDINARY_API_KEY__"

debug: false
logging-to-file: true
logs-max-total-size-mb: 512
error-logs-max-files: 10
# Error-only diagnostics when full request logging is disabled. The default
# metadata mode records bounded request/response sizes, status and sanitized
# machine-readable error fields, never request, response or upstream bodies.
# Use off to disable these forced error files. body is intentionally rejected.
error-log-capture:
  mode: metadata
# Bravo keeps its own persistent analytics; this disables only legacy host stats.
usage-statistics-enabled: false

plugins:
  enabled: true
  dir: plugin-dist
  configs:
    bravo:
      enabled: true
      prefix: bravo/
      require_smart_key: true
      max_attempts: 0
      cooldown_seconds: 30
      # Start one contract-compatible cross-provider stream attempt if the
      # primary has not produced its first payload after this many seconds.
      # Set to 0 to keep purely sequential fallback.
      fallback_hedge_delay_seconds: 40
      state_path: bravo-data/bravo-state.json
      allocator_mode: enforce
      # preview.12: breaker reacts only to a real, reviewed quota/rate-limit
      # failure and immediately continues the configured neighboring route.
      # Forecasts remain shadow-only; there are no queues or background calls,
      # and at most one global single-flight recovery probe per breaker
      # generation prevents subscription retry stampedes.
      adaptive_allocator_mode: breaker
      quota_refresh_seconds: 60
      unknown_secondary_policy: block
      smart_keys: []
