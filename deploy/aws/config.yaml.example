host: ""
port: 8317

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  # Docker bridge traffic is not localhost inside the container. Host exposure
  # is still restricted to 127.0.0.1 by docker-compose.yml.
  allow-remote: true
  # prepare-runtime.sh replaces this value. CLIProxyAPI hashes it on startup.
  secret-key: "__MANAGEMENT_KEY__"
  disable-control-panel: false
  # The image contains the matching Bravo UI. Never replace it with upstream UI.
  disable-auto-update-panel: true

auth-dir: "/root/.cli-proxy-api"

# Ordinary break-glass key for native CLIProxyAPI routes. It cannot access
# bravo/*; project Bravo keys are created later in the Management UI.
api-keys:
  - "__ORDINARY_API_KEY__"

debug: false
logging-to-file: true
logs-max-total-size-mb: 512
error-logs-max-files: 10
# Bravo keeps its own persistent analytics; this disables only legacy host stats.
usage-statistics-enabled: false

plugins:
  enabled: true
  dir: plugin-dist
  configs:
    bravo:
      enabled: true
      prefix: bravo/
      require_smart_key: true
      max_attempts: 0
      cooldown_seconds: 30
      state_path: bravo-data/bravo-state.json
      allocator_mode: enforce
      quota_refresh_seconds: 60
      unknown_secondary_policy: block
      smart_keys: []
